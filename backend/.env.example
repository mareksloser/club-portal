# Club login (OpenID Connect). Issuer without a trailing slash; client = the portal SPA client in the IdP admin.
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=portal-web
# Where the IdP's public keys are cached (relative to backend/)
#OIDC_JWKS_CACHE=tmp/cache/jwks.json

# Shown in the header and the page title
CLUB_NAME="SK Baník Libušín"

# Comma separated origins allowed to call the API from the browser (only needed when the SPA runs elsewhere)
CORS_ORIGINS=
# Behind a reverse proxy / load balancer: its IP(s), so X-Forwarded-For is trusted
TRUSTED_PROXIES=
APP_DEBUG=false
