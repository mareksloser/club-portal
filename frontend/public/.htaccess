# Used both when the SPA is served on its own and when frontend/dist is copied into
# backend/public (it then replaces the backend's .htaccess, so it must route /api too).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # API → PHP front controller
  RewriteCond %{REQUEST_URI} ^/api(/|$)
  RewriteCond %{DOCUMENT_ROOT}/index.php -f
  RewriteRule ^ index.php [QSA,L]

  # Existing files (assets, favicon) as they are; everything else is the SPA
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]

  # Apache strips Authorization by default
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# index.html must not be cached (it points to the current build),
# files in /assets have a hash in their name, so they can be cached forever
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
